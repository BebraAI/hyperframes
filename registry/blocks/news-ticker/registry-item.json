{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "news-ticker",
  "type": "hyperframes:block",
  "title": "News Ticker",
  "description": "Premium broadcast-style lower-third ticker with live label, headline ribbon, and scrolling news crawl.",
  "tags": ["lower-third", "overlay", "news", "ticker"],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 7,
  "files": [
    {
      "path": "news-ticker.html",
      "target": "compositions/news-ticker.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "label",
      "type": "string",
      "label": "Label",
      "description": "The tag before the crawl.",
      "default": "Breaking"
    },
    {
      "id": "desk",
      "type": "string",
      "label": "Desk",
      "description": "The desk name under LIVE.",
      "default": "Global Desk"
    },
    {
      "id": "headline",
      "type": "string",
      "label": "Headline",
      "description": "The main line, set large.",
      "default": "AI video tools move from prototype to production"
    },
    {
      "id": "time",
      "type": "string",
      "label": "Time",
      "default": "09:41 UTC"
    }
  ]
}
